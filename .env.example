# Arc Cross-Border Payments Environment Configuration
# Copy this to frontend/.env.local and fill in your addresses

# ===== ARC NETWORK CONFIGURATION =====
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network

# ===== SMART CONTRACT ADDRESSES =====
# Your deployed CrossBorderPayments contract address
NEXT_PUBLIC_ARC_CONTRACT_ADDRESS=0x75646fd9b8fADa1456B600315c5F8EB76FA53eaa

# ===== TOKEN ADDRESSES ON ARC TESTNET =====
# Native USDC token address (ERC-20 interface)
NEXT_PUBLIC_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Bridged USDC (optional)
NEXT_PUBLIC_ARC_USDCE_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b1566469cb3

# ===== FEATURE FLAGS =====
NEXT_PUBLIC_TESTNET_MODE=true

# ===== ADMIN SETTINGS (OPTIONAL) =====
# Admin password for accessing admin dashboard
# NEXT_PUBLIC_ADMIN_PASSWORD=your_secure_password_here
